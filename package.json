{
  "name": "cerebro",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:hook && npm run tauri -- dev",
    "build": "npm run build:hook && npm run tauri -- build",
    "install:macos": "npm run build:hook && sh scripts/install-macos.sh",
    "build:hook": "sh scripts/with-rust.sh sh scripts/build-hook.sh",
    "tauri": "sh scripts/with-rust.sh tauri",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:ui": "vitest run",
    "test:rust": "sh scripts/with-rust.sh cargo test --workspace",
    "lint:rust": "sh scripts/with-rust.sh cargo clippy --workspace --all-targets -- -D warnings",
    "test": "npm run test:rust && npm run test:ui"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
